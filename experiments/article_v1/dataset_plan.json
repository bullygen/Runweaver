        "target_snr": [3.0, 5.0, 10.0, 20.0, 40.0],
        "noise_model": ["gaussian", "gaussian", "correlated"],
        "background_value": [0.0, 0.001, 0.003, 0.006],
        "background_gradient": [0.0, 0.002, 0.006],
        "background_class": ["jet", "jet", "two_blob", "smooth_disk", "turbulent"],
        "beam_fwhm_px": [0.0, 2.0, 4.0, 8.0],
        "uv_coverage": ["filled", "filled", "eht_sparse", "ng_eht_dense"],
        "variability_fraction": [0.0, 0.0, 0.03, 0.08],
        "ring_profile": ["gaussian", "gaussian", "gaussian", "lorentzian", "variable_width", "partial"],
        "parameter_domain": ["id_core", "id_core", "id_core", "id_boundary"],
        "overlap_mode": ["random", "random", "random", "clustered"],
