  "design_notes": {
    "unit": "one independently generated sky family and one observational realization",
    "split_rule": "family_id and seed ranges are disjoint across splits",
    "snr_definition": "RMS of the observed ring-only component divided by realized noise standard deviation; nulls use an unobserved phantom ring for matched noise calibration",
