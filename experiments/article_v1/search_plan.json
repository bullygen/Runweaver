{
  "version": "article-search-v1.0",
  "dataset_root": "datasets/article_v1",
  "base_config": "experiments/article_v1/base_pipeline_config.json",
  "output_root": "experiment_runs/article_v1",
  "search_seed": 20260721,
  "starts": 4,
  "trials_per_start": 6,
  "locked_method_hypotheses": {
    "d1_mask_method": "percentile_cc",
    "d1_edge_method": "legacy_laplace_positive",
    "d1_threshold_method": "positive",
    "d1_morphology_method": "legacy_control_open",
    "d2_method": "sparse_rht_stratified",
    "d2_vote_weight": "mean",
    "d3_method": "ph_union_find_sparse",
    "d3_threshold_method": "bootstrap",
    "d4_method": "profile_harmonic",
    "d5_engine": "scipy",
    "d5_loss": "soft_l1",
    "d5_residual_weighting": "ring_support",
    "d6_method": "amplitude_merge_delta_bic"
  },
  "search_space": {
    "d1_jet_percentile": {"type": "float", "low": 99.2, "high": 99.9},
    "d1_legacy_badpix": {"type": "float", "low": 0.04, "high": 0.10},
    "d2_votes_fraction": {"type": "float", "low": 0.18, "high": 0.38},
    "d2_min_triangle_area": {"type": "float", "low": 8.0, "high": 30.0},
    "d2_n_sectors": {"type": "int", "low": 8, "high": 18},
    "d3_bootstrap_quantile": {"type": "float", "low": 0.0, "high": 0.35},
    "d3_nms_dx": {"type": "float", "low": 3.0, "high": 8.0},
    "d3_nms_dr": {"type": "float", "low": 2.0, "high": 7.0},
    "d3_max_candidates": {"type": "int", "low": 12, "high": 20},
    "d4_strip_half_width": {"type": "float", "low": 3.0, "high": 7.0},
    "d4_radial_window": {"type": "float", "low": 7.0, "high": 14.0},
    "d5_f_scale": {"type": "log_float", "low": 0.3, "high": 2.0},
    "d6_amp_min": {"type": "float", "low": 0.008, "high": 0.020},
    "d6_delta_bic_threshold": {"type": "log_float", "low": 1000.0, "high": 15000.0},
    "d6_merge_center_px": {"type": "float", "low": 3.0, "high": 9.0}
  },
  "derived_equal": {
    "d6_merge_radius_px": "d6_merge_center_px"
  },
  "objective": {
    "description": "worst article_geometric_iou_v1 image-bootstrap F1 lower bound across algorithm seeds, penalized for seed instability and null false positives",
    "precision_floor": 0.80,
    "recall_floor": 0.70,
    "seed_std_penalty": 0.25,
    "null_fppi_penalty": 0.05,
    "infeasible_penalty": 1.0
  },
  "workers": {
    "d1": 4,
    "d2": 4,
    "d3": 2,
    "d4": 4,
    "d5": 2,
    "d6": 4
  },
  "phases": {
    "smoke": {
      "split": "development",
      "source": "all",
      "folds": [0, 1, 2, 3, 4],
      "max_images": 1,
      "algorithm_seeds": [239],
      "config_overrides": {"d2_max_votes": 20000, "d5_max_nfev": 50},
      "save_arrays": false
    },
    "screening": {
      "split": "development",
      "source": "all",
      "folds": [0, 1, 2, 3, 4],
      "max_images": 60,
      "algorithm_seeds": [239],
      "config_overrides": {"d2_max_votes": 120000, "d5_max_nfev": 250},
      "save_arrays": false
    },
    "promotion": {
      "split": "development",
      "source": "top_from:screening",
